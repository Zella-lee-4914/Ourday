ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# developers.naver.com > 애플리케이션 등록 > "검색" API 사용 설정 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# upstash.com > Redis 데이터베이스 생성 후 REST API 탭에서 발급.
# 비워두면 투표방 데이터가 서버 메모리에만 저장되어 재시작 시 사라진다(로컬 개발용 폴백).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
